#!/usr/bin/env bash
# The fast gate: headless import, then every gdUnit4 suite under res://tests.
# Exits 0 only when both succeed with no failures, errors or orphan nodes.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
godot="${GATE_GODOT:-godot}"

say() { echo "gate-fast: $*" >&2; }

if [ "$#" -ne 0 ]; then
  say "usage: scripts/gate-fast (takes no arguments)"
  exit 2
fi

if ! command -v "$godot" >/dev/null; then
  say "no godot at $godot; run brew install --cask godot"
  exit 1
fi

lock="$repo/gate-fast.gate.lock"

take_lock() {
  local holder
  if mkdir "$lock" 2>/dev/null; then printf '%s\n' "$$" > "$lock/pid"; return 0; fi
  holder="$(cat "$lock/pid" 2>/dev/null || true)"
  case "$holder" in
    ''|*[!0-9]*) holder="" ;;
  esac
  if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
    say "another gate-fast is already running in $repo (pid $holder); wait for it to finish"
    exit 1
  fi
  say "reclaiming a stale lock in $repo"
  rm -rf "$lock"
  if mkdir "$lock" 2>/dev/null; then printf '%s\n' "$$" > "$lock/pid"; return 0; fi
  say "another gate-fast took the lock in $repo; wait for it to finish"
  exit 1
}

take_lock
: > "$lock/.gdignore"
trap 'rm -rf "$lock"' EXIT INT TERM

slug="$(printf '%s' "$(basename "$repo")" | tr -c 'A-Za-z0-9._-' '_')-$(printf '%s' "$repo" | shasum | cut -c1-8)"

if [ -e "$repo/override.cfg" ] && { [ ! -f "$repo/override.cfg" ] || [ "$(head -n 1 "$repo/override.cfg")" != "; temporary: written by scripts/gate-fast, removed when it exits" ]; }; then
  say "override.cfg already exists in $repo and was not written by gate-fast; move it aside and rerun"
  exit 1
fi

cat > "$repo/override.cfg" <<EOF
; temporary: written by scripts/gate-fast, removed when it exits

[application]

config/use_custom_user_dir=true
config/custom_user_dir_name="Tide and Timber/gate/$slug"
EOF
trap 'rm -f "$repo/override.cfg"; rm -rf "$lock"' EXIT INT TERM

say "user data dir Tide and Timber/gate/$slug"

say "importing"
if "$godot" --headless --path "$repo" --import; then :; else
  n=$?
  say "import failed (exit $n)"
  exit 1
fi

say "running gdUnit4 suites in res://tests"
if "$godot" --headless --path "$repo" -d --remote-debug tcp://127.0.0.1:0 \
  --script res://addons/gdUnit4/bin/GdUnitCmdTool.gd --ignoreHeadlessMode \
  -c -a res://tests -rd res://reports -rc 1; then :; else
  n=$?
  say "gdUnit4 suites failed (exit $n)"
  exit 1
fi

say "green"
