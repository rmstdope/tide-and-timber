# Cerebro writes these while the fleet runs; the declarations beside them are tracked.
.cerebro/worktrees
.cerebro/state
.cerebro/scratch

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Godot
.godot/

# gdUnit4 reports, written by scripts/gate-fast
/reports/

# Release exports, written by scripts/gate-full
/build/

# Written by scripts/gate-fast while it runs, and removed when it exits.
/override.cfg
/gate-fast.gate.lock/

# MacOS
.DS_Store

# Temp directories
tmp